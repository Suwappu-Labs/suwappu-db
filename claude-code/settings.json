{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(rustup:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --no-rebase:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform output:*)",
      "Bash(terraform state list:*)",
      "Bash(terraform state show:*)",
      "Bash(aws ec2 describe-instances:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws s3api list-objects:*)",
      "Bash(aws logs tail:*)",
      "Bash(aws logs describe-log-groups:*)",
      "Bash(aws ecr describe-repositories:*)",
      "Bash(aws ecr describe-images:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws iam get-user:*)",
      "Bash(aws iam list-roles:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(scripts/check-lane-separation.sh:*)",
      "Bash(./scripts/check-lane-separation.sh:*)",
      "Bash(scripts/bootstrap.sh smoke:*)",
      "Bash(./scripts/bootstrap.sh smoke:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh repo create:*)",
      "Bash(gh release create:*)",
      "Bash(gh release upload:*)",
      "Bash(scripts/bootstrap.sh init-repo:*)",
      "Bash(scripts/bootstrap.sh deploy-aws:*)",
      "Bash(scripts/bootstrap.sh release:*)",
      "Bash(./scripts/bootstrap.sh init-repo:*)",
      "Bash(./scripts/bootstrap.sh deploy-aws:*)",
      "Bash(./scripts/bootstrap.sh release:*)",
      "Bash(cargo install:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo yank:*)",
      "Bash(docker build:*)",
      "Bash(docker push:*)",
      "Bash(npm install:*)",
      "Bash(brew install:*)",
      "Bash(brew uninstall:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~/:*)",
      "Bash(rm -rf ~/*:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform apply:*)",
      "Bash(aws ec2 terminate-instances:*)",
      "Bash(aws ec2 stop-instances:*)",
      "Bash(aws iam delete-user:*)",
      "Bash(aws iam delete-role:*)",
      "Bash(aws iam delete-policy:*)",
      "Bash(aws iam detach-role-policy:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws ecr delete-repository:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v cargo >/dev/null 2>&1 && [ -f Cargo.toml ]; then cargo fmt --check >/dev/null 2>&1 || echo '[hint] cargo fmt drift detected — run: cargo fmt'; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(printf '%s' \"$input\" | jq -r '.tool_input.command // empty'); case \"$cmd\" in *'rm -rf /'*|*'rm -rf ~'*|*'rm -rf $HOME'*) echo '{\"decision\":\"block\",\"reason\":\"destructive rm -rf blocked by suwappu-db PreToolUse hook\"}'; exit 0;; *'git push --force'*|*'git push -f '*) echo '{\"decision\":\"block\",\"reason\":\"force push blocked by suwappu-db PreToolUse hook\"}'; exit 0;; *'terraform destroy'*) echo '{\"decision\":\"block\",\"reason\":\"terraform destroy blocked by suwappu-db PreToolUse hook\"}'; exit 0;; esac"
          }
        ]
      }
    ]
  }
}
